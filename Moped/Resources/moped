#!/bin/bash
#
# moped — open files in the Moped.app text editor
#
# Moped - A general purpose text editor, small and light.
# Copyright © 2019-2026 Roberto Machorro. All rights reserved.
#
# This script is licensed under the GNU General Public License v3 or later;
# see <https://www.gnu.org/licenses/> for details.
#
# Why a shell script and not a Swift binary? Mac App Store validation requires
# every bundled Mach-O to be sandboxed (validation rule 90296), and a sandboxed
# CLI cannot access files handed to it as argv — `files.user-selected.*`
# entitlements only grant access to files the user picked via an Open panel.
# An interpreted script is not a Mach-O, so rule 90296 does not apply; this
# script runs unsandboxed under the user's shell, and /usr/bin/open inherits
# that same unsandboxed context, so the resulting kAEOpenDocuments AppleEvent
# crosses into Moped.app the normal way (with a proper powerbox grant).
#
# Talking back to the app: the script and the sandboxed app share no channel but
# the files themselves. macOS's app data protection stops the user's shell from
# writing into the app's container, and the app can always write to a document
# it has open, so both directions use extended attributes on the opened files
# (CLIFileTags.swift holds the app's side):
#
# - PLACEHOLDER_XATTR marks a file this script created because it did not exist.
# - WAIT_XATTR is what --wait polls. The script sets it to `pending`, the app
#   changes it to `open` once the document is on screen and removes it when the
#   window closes or the app quits.

set -e

BUNDLE_ID="net.machorro.roberto.Moped"
PLACEHOLDER_XATTR="net.machorro.roberto.Moped.placeholder"
WAIT_XATTR="net.machorro.roberto.Moped.wait"

usage() {
	printf 'Usage: moped [--wait] <file>...\n' >&2
	exit 1
}

wait_mode=0
files=()
for arg in "$@"; do
	case "$arg" in
		--wait)     wait_mode=1 ;;
		-h|--help)  usage ;;
		*)          files+=("$arg") ;;
	esac
done

[ ${#files[@]} -eq 0 ] && usage

# Convert each file path to absolute form, so `open` and `xattr` agree on it
# whatever the app's working directory.
#
# A path that does not exist yet is created empty first, so `moped new.txt`
# opens a blank document that saves back to that name. The sandboxed app could
# not create it on save by itself: it may only write where it was handed a file.
# The PLACEHOLDER_XATTR tag asks Moped to delete the file again if it is still
# empty when its window closes (CLIFileTags.swift); a filesystem without
# extended attributes only loses that cleanup. If the file cannot be created
# (its directory is missing, say), `open` below reports it as missing instead.
abs_files=()
for f in "${files[@]}"; do
	case "$f" in
		/*) abs="$f" ;;
		*)  abs="$PWD/$f" ;;
	esac
	if [ ! -e "$abs" ] && touch "$abs" 2>/dev/null; then
		xattr -w "$PLACEHOLDER_XATTR" 1 "$abs" 2>/dev/null || true
	fi
	abs_files+=("$abs")
done

# Tag the files to wait for before `open`, so the tag is already there however
# fast the app is: a missing tag can only ever mean "closed". A file that cannot
# be tagged — one you cannot write to — cannot be waited for; a missing one is
# left for `open` to report.
tagged=()
if [ "$wait_mode" = "1" ]; then
	for f in "${abs_files[@]}"; do
		if xattr -w "$WAIT_XATTR" pending "$f" 2>/dev/null; then
			tagged+=("$f")
		elif [ -e "$f" ]; then
			printf 'moped: cannot wait for %s\n' "$f" >&2
		fi
	done

	# On Ctrl-C, or a file given up on below, take the tags back off so
	# nothing is left behind on the user's files.
	cleanup() {
		for f in "${tagged[@]}"; do
			xattr -d "$WAIT_XATTR" "$f" 2>/dev/null || true
		done
	}
	trap cleanup INT TERM EXIT
fi

# Hand the files to Moped via Launch Services. Because this script runs
# unsandboxed under the user's shell, /usr/bin/open is also unsandboxed,
# and the resulting Apple Event reaches Moped.app with a proper powerbox
# grant for the opened documents.
#
# `open` exits non-zero when any argument fails (e.g. a missing file) even
# though it still opens the rest, so a failure must not abort --wait: the
# files that did open still deserve their wait. The status is carried
# through as the script's own exit code.
open_status=0
/usr/bin/open -b "$BUNDLE_ID" "${abs_files[@]}" || open_status=$?

# Wait until every tag is gone. A tag still `pending` after ~10 s belongs to a
# file Moped never showed — refused as binary or too large — and is given up
# on, so a failed open cannot hang the caller's terminal. A crash leaves `open`
# tags behind, so the wait also ends once Moped is no longer running; that is
# only checked after the first couple of seconds, while a cold launch may not
# have a process yet.
waiting=("${tagged[@]}")
ticks=0
while [ ${#waiting[@]} -gt 0 ]; do
	remaining=()
	for f in "${waiting[@]}"; do
		state="$(xattr -p "$WAIT_XATTR" "$f" 2>/dev/null)" || continue
		if [ "$state" = "pending" ] && [ "$ticks" -ge 20 ]; then
			continue
		fi
		remaining+=("$f")
	done
	waiting=("${remaining[@]}")
	[ ${#waiting[@]} -eq 0 ] && break

	if [ "$ticks" -ge 4 ] && ! pgrep -qx Moped 2>/dev/null; then
		break
	fi
	ticks=$((ticks + 1))
	sleep 0.5
done

exit "$open_status"
